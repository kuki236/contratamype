# Web (Next.js) apuntando a la API local
CONTRATAMYPE_API_URL=http://127.0.0.1:8000

# Explicador: "template" (default) o "gemini".
# Gemini solo redacta la introducción; los 8 puntos, citas y disclaimer
# siguen viniendo de la plantilla. Sin key o si falla, se usa la plantilla.
CONTRATAMYPE_EXPLAINER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
