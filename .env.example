# Copia este archivo a .env y nunca commitees valores reales.

# Base local del pipeline (read-only para la API)
CONTRATAMYPE_DB=data/processed/contratamype.duckdb

# URL de la API read-only que consume la web
CONTRATAMYPE_API_URL=http://127.0.0.1:8000

# Explicador: solo "template" está implementado en v1.0.
# Un valor desconocido (por ejemplo "gemini") cae a la plantilla.
CONTRATAMYPE_EXPLAINER=template

# Reservado para el adaptador Gemini (no implementado en v1.0).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
